<UserControl
    x:Class="ExpenseTracker.View.Templates.ExpenseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ExpenseTracker.Wpf.Controls;assembly=ExpenseTracker.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ExpenseTracker.View.Templates"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DataContext="{d:DesignInstance local:ExpenseViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="300"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <Grid>
        <DataGrid
            x:Name="ExpenseDataGrid"
            Grid.Row="1"
            MinHeight="100"
            Margin="15"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            Focusable="True"
            HorizontalScrollBarVisibility="Auto"
            ItemsSource="{Binding Expense.Entries}"
            PreparingCellForEdit="ExpenseDataGrid_PreparingCellForEdit"
            SelectionChanged="ExpenseDataGrid_SelectionChanged"
            SelectionMode="Extended"
            VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.CacheLength="2,2"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Item"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.CommandBindings>
                <CommandBinding Command="Copy" Executed="ExpenseDataGrid_OnCopy" />
            </DataGrid.CommandBindings>
            <DataGrid.Resources>
                <Style BasedOn="{StaticResource {x:Type GridSplitter}}" TargetType="{x:Type GridSplitter}">
                    <Setter Property="Background" Value="{StaticResource Brush.Border.Background.Alt}" />
                </Style>
                <!--  Lets the dropdown columns open with a single click  -->
                <Style
                    x:Key="ComboCellStyle"
                    BasedOn="{StaticResource {x:Type DataGridCell}}"
                    TargetType="{x:Type DataGridCell}">
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ComboCell_PreviewMouseLeftButtonDown" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <Separator />
                    <MenuItem Command="{Binding CopyEntryCommand}" Header="Copy" />
                    <MenuItem Command="{Binding PasteEntryCommand}" Header="Paste" />
                    <Separator />
                    <MenuItem Command="{Binding RemoveEntryCommand}" Header="Remove" />
                    <Separator />
                    <MenuItem Command="{Binding SortEntriesCommand}" Header="Sort Entries" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="250"
                    MinWidth="200"
                    Binding="{Binding Description}"
                    Header="Description" />
                <DataGridTemplateColumn
                    Width="170"
                    MinWidth="150"
                    CellStyle="{StaticResource ComboCellStyle}"
                    Header="Payment Channel">
                    <!--  Read only view: plain text keeps rows cheap to create while scrolling  -->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding PaymentChannel}"
                                    TextTrimming="CharacterEllipsis" />
                                <GridSplitter
                                    Grid.Column="1"
                                    Width="1"
                                    DragDelta="GridSplitter_DragDelta"
                                    DragIncrement="1"
                                    Tag="{Binding BindsDirectlyToSource=True, RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <!--  Editable view: Payment Channel  -->
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <controls:SearchableComboBox ItemsSource="{Binding Path=DataContext.PaymentChannels, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}" SelectedItem="{Binding PaymentChannel, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Width="150"
                    CanUserResize="True"
                    CellStyle="{StaticResource ComboCellStyle}"
                    Header="Category">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding ExpenseCategory}"
                                    TextTrimming="CharacterEllipsis" />
                                <GridSplitter
                                    Grid.Column="1"
                                    Width="1"
                                    DragDelta="GridSplitter_DragDelta"
                                    DragIncrement="1"
                                    Tag="{Binding BindsDirectlyToSource=True, RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <!--  Editable view: Category  -->
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <controls:SearchableComboBox ItemsSource="{Binding Path=DataContext.Categories, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}" SelectedItem="{Binding ExpenseCategory, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="130" CanUserResize="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.MainCurrencyString, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, StringFormat='Amount ( {0} )'}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>

                    <!--  Read only view  -->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Amount}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <!--  Editable view  -->
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                PreviewTextInput="Txt_Amount_PreviewTextInput"
                                Style="{StaticResource TextBoxStyle.DataGridRowEditor}"
                                Text="{Binding Amount, UpdateSourceTrigger=LostFocus}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="130"
                    Binding="{Binding OriginalAmount}"
                    EditingElementStyle="{StaticResource TextBoxStyle.DataGridRowEditor}"
                    Header="Amount (Local)" />
                <DataGridTemplateColumn
                    Width="170"
                    MinWidth="150"
                    CellStyle="{StaticResource ComboCellStyle}"
                    Header="Currency">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Currency}"
                                    TextTrimming="CharacterEllipsis" />
                                <GridSplitter
                                    Grid.Column="1"
                                    Width="1"
                                    DragDelta="GridSplitter_DragDelta"
                                    DragIncrement="1"
                                    Tag="{Binding BindsDirectlyToSource=True, RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <!--  Editable view: Currency  -->
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <controls:SearchableComboBox ItemsSource="{Binding Path=DataContext.CurrencyInfos, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}" SelectedItem="{Binding Currency, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Comments}"
                    Header="Comments" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
