<UserControl
    x:Class="ExpenseTracker.View.Tools.PaymentChannelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ExpenseTracker.View.Tools"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootControl"
    d:DataContext="{d:DesignInstance local:PaymentChannelsViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border BorderBrush="{StaticResource Brush.Button.Alt}">
        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource TextBlockStyle.Header1.Bold}" Text="Payment Channels" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ListView
                        x:Name="ListView_PaymenChannels"
                        MinHeight="{Binding ActualHeight, ElementName=RootControl}"
                        ItemsSource="{Binding PaymentChannels}"
                        SelectedItem="{Binding SelectedChannel, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding AddPaymentChannelCommand}" Header="Add" />
                                <MenuItem Command="{Binding RemovePaymentChannelCommand}" Header="Remove" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox Width="200" Text="{Binding PaymenChannelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
