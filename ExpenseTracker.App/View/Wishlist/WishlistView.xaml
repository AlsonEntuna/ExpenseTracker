<UserControl
    x:Class="ExpenseTracker.View.Wishlist.WishlistView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="WishlistColumnList" TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,8,0,8" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="WishlistCardTemplate">
            <Border
                Padding="14"
                Background="{DynamicResource Brush.Main.Background.Alt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8"
                MouseLeftButtonDown="WishlistCard_MouseLeftButtonDown"
                ToolTip="Double-click to add saved money · Drag to change status">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{DynamicResource Brush.Main.Text.Alt}"
                            Text="{Binding TargetAmount, StringFormat={}{0:N0} €}" />
                    </Grid>
                    <ProgressBar
                        Grid.Row="1"
                        Height="5"
                        Background="{DynamicResource Brush.Main.Background}"
                        BorderThickness="0"
                        Foreground="{DynamicResource Brush.Button.Alt}"
                        Maximum="100"
                        Value="{Binding Progress, Mode=OneWay}" />
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Foreground="{DynamicResource Brush.Main.Text.Alt}" Text="{Binding SavedAmount, StringFormat={}{0:N0} € saved}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Foreground="{DynamicResource Brush.Main.Text.Alt}"
                            Text="{Binding AchievedDate, StringFormat={}{0:dd MMM yyyy}}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TextBlockStyle.Header1.Bold}" Text="Wishlists" />
                <TextBlock
                    Margin="0,3,0,0"
                    Foreground="{DynamicResource Brush.Main.Text.Alt}"
                    Text="Keep the things you’re saving for in one place." />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Brush.Main.Text.Alt}"
                Text="Double-click an item to add savings · Drag to move it"
                TextWrapping="Wrap" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,0,0,16"
            Padding="12"
            Background="{DynamicResource Brush.Main.Background.Alt}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock
                        Margin="1,0,0,4"
                        Foreground="{DynamicResource Brush.Main.Text.Alt}"
                        Text="Item name" />
                    <TextBox
                        Padding="10,7"
                        VerticalContentAlignment="Center"
                        Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddItemCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock
                        Margin="1,0,0,4"
                        Foreground="{DynamicResource Brush.Main.Text.Alt}"
                        Text="Target amount (€)" />
                    <TextBox
                        Padding="10,7"
                        VerticalContentAlignment="Center"
                        Text="{Binding NewItemTarget, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddItemCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Height="34"
                    MinWidth="120"
                    Margin="0,21,0,0"
                    Padding="16,0"
                    Command="{Binding AddItemCommand}"
                    Content="+  Add item"
                    Style="{StaticResource ButtonStyle.Element}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220" />
                <ColumnDefinition Width="*" MinWidth="220" />
                <ColumnDefinition Width="*" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Margin="0,0,10,0"
                Padding="14"
                Background="{DynamicResource Brush.Main.Background}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,4">
                        <Border
                            Width="8"
                            Height="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Main.Text.Alt}"
                            CornerRadius="4" />
                        <TextBlock Style="{StaticResource TextBlockStyle.Header2.Bold}" Text="Items" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.Main.Text.Alt}"
                            Text="{Binding Items.Count}" />
                    </DockPanel>
                    <ListView
                        Grid.Row="1"
                        AllowDrop="True"
                        Drop="WishlistList_Drop"
                        ItemTemplate="{StaticResource WishlistCardTemplate}"
                        ItemsSource="{Binding Items}"
                        PreviewMouseLeftButtonDown="WishlistList_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="WishlistList_PreviewMouseMove"
                        Style="{StaticResource WishlistColumnList}"
                        Tag="Items" />
                </Grid>
            </Border>
            <Border
                Grid.Column="1"
                Margin="5,0"
                Padding="14"
                Background="{DynamicResource Brush.Main.Background}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,4">
                        <Border
                            Width="8"
                            Height="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Button.Alt}"
                            CornerRadius="4" />
                        <TextBlock Style="{StaticResource TextBlockStyle.Header2.Bold}" Text="In progress" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.Main.Text.Alt}"
                            Text="{Binding InProgressItems.Count}" />
                    </DockPanel>
                    <ListView
                        Grid.Row="1"
                        AllowDrop="True"
                        Drop="WishlistList_Drop"
                        ItemTemplate="{StaticResource WishlistCardTemplate}"
                        ItemsSource="{Binding InProgressItems}"
                        PreviewMouseLeftButtonDown="WishlistList_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="WishlistList_PreviewMouseMove"
                        Style="{StaticResource WishlistColumnList}"
                        Tag="InProgress" />
                </Grid>
            </Border>
            <Border
                Grid.Column="2"
                Margin="10,0,0,0"
                Padding="14"
                Background="{DynamicResource Brush.Main.Background}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,4">
                        <Border
                            Width="8"
                            Height="8"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Hover.Active.1}"
                            CornerRadius="4" />
                        <TextBlock Style="{StaticResource TextBlockStyle.Header2.Bold}" Text="Achieved" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.Main.Text.Alt}"
                            Text="{Binding AchievedItems.Count}" />
                    </DockPanel>
                    <ListView
                        Grid.Row="1"
                        AllowDrop="True"
                        Drop="WishlistList_Drop"
                        ItemTemplate="{StaticResource WishlistCardTemplate}"
                        ItemsSource="{Binding AchievedItems}"
                        PreviewMouseLeftButtonDown="WishlistList_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="WishlistList_PreviewMouseMove"
                        Style="{StaticResource WishlistColumnList}"
                        Tag="Achieved" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
