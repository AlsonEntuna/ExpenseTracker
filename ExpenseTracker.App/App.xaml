<Application
    x:Class="ExpenseTracker.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:piggybank="clr-namespace:ExpenseTracker.View.PiggyBank"
    xmlns:views="clr-namespace:ExpenseTracker.View"
    xmlns:vms="clr-namespace:ExpenseTracker.ViewModels"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ExpenseTracker.Wpf;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Views  -->
            <DataTemplate DataType="{x:Type vms:HomepageViewModel}">
                <views:HomepageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:ExpenseControlViewModel}">
                <views:ExpenseViewControl />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:PiggyBankViewModel}">
                <piggybank:PiggyBankView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:ToolsAndPreferencesViewModel}">
                <views:ToolsAndPreferencesView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
